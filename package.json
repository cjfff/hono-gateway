{
  "name": "node-gateway",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "demo:book": "tsx watch servers/book-api/server.ts",
    "demo:static": "tsx watch servers/static-server/server.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate --config src/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config src/db/drizzle.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@libsql/client": "^0.15.15",
    "@types/http-proxy": "^1.17.17",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.10.7",
    "http-proxy": "^1.18.1",
    "log4js": "^6.9.1",
    "redbird": "^1.0.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  }
}